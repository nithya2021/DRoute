PORT=3001
NODE_ENV=development

# The client defaults to http://localhost:3001/api and needs no configuration
# for local development. To point it elsewhere, set VITE_API_URL in
# packages/client/.env — Vite only reads VITE_-prefixed vars, and only from
# its own package directory.

# OneMap gives exact building coordinates instead of postal-district centres.
# Optional: without it the app falls back to district positions, accurate to a
# kilometre or two. Register free at https://www.onemap.gov.sg/apidocs/register
#
# Prefer email/password: OneMap tokens expire after ~3 days, and these let the
# app fetch a fresh one automatically. ONEMAP_TOKEN is for a quick one-off test.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# ONEMAP_TOKEN=
