PORT=3001
NODE_ENV=development
REACT_APP_API_URL=http://localhost:3001/api

# Supabase Configuration
# SUPABASE_SECRET_KEY is the "Secret key" (sb_secret_...) from
# Settings > API Keys. It bypasses row level security, so keep it server-side
# only: never expose it to the browser and never commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_secret_key_here
