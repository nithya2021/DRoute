PORT=3001
NODE_ENV=development

# The client defaults to http://localhost:3001/api and needs no configuration
# for local development. To point it elsewhere, set VITE_API_URL in
# packages/client/.env — Vite only reads VITE_-prefixed vars, and only from
# its own package directory.

# Supabase Configuration
# SUPABASE_SECRET_KEY is the "Secret key" (sb_secret_...) from
# Settings > API Keys. It bypasses row level security, so keep it server-side
# only: never expose it to the browser and never commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_secret_key_here
